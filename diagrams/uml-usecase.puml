@startuml uml-usecase
!theme plain
left to right direction
skinparam packageStyle rectangle

actor "Спортсмен" as c
actor "Тренер" as m
actor "Администратор" as d

rectangle "Система «Спортивные секции»" {
  usecase "Просмотреть расписание" as UC1
  usecase "Записаться на занятие" as UC2
  usecase "Отменить запись" as UC3
  usecase "Просмотреть свои записи" as UC4
  usecase "Просмотреть группу" as UC5
  usecase "Отметить посещаемость" as UC6
  usecase "Управлять расписанием" as UC7
  usecase "Проверить конфликт залов" as UC8
}

c --> UC1
c --> UC2
c --> UC3
c --> UC4
m --> UC5
m --> UC6
d --> UC7
UC7 ..> UC8 : <<include>>

@enduml